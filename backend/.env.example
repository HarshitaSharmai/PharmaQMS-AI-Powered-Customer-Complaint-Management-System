# Copy this file to .env and fill in real values. Never commit a real .env.

# --- Database ---
# Postgres example:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/complaints_db
# MySQL example (comment out the line above and use this instead):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/complaints_db

# --- Groq ---
# Create a key at https://console.groq.com
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_FAST_MODEL=gemma2-9b-it
GROQ_CONTEXT_MODEL=llama-3.3-70b-versatile

# --- App ---
CORS_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_MB=10
DUPLICATE_SIMILARITY_THRESHOLD=0.72
